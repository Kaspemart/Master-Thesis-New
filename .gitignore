# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Data (generated datasets not committed — too large, regenerate via scripts/generate_datasets.py)
data/*
!data/.gitkeep
!data/generated/.gitkeep
data/generated/*.npz

# Results — per-series MCMC checkpoints redundant with results.npz, exclude to keep repo small
results/*/checkpoints/series_*.npz

# Model checkpoints — binary weights, regenerate via scripts/train_best_configs.py
checkpoints/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code tooling artifacts
.claude/

# Misspecification per-series stochvol checkpoints — redundant with assembled *_stochvol.npz
results/misspec/*/series_*.npz
results/misspec/*/results.npz
